public with sharing class RollupCalculatorAction {

    public class RollupRequest {
        @InvocableVariable(required=true label='Object API Name')
        public String objectApiName;

        @InvocableVariable(required=true label='Field API Name to Aggregate')
        public String fieldApiName;

        @InvocableVariable(required=true label='Operation (SUM, COUNT, MAX, MIN, AVG)')
        public String operation;

        @InvocableVariable(label='Filter Condition (optional, e.g. AccountId = \'001xx\')')
        public String filterCondition;
    }

    public class RollupResult {
        @InvocableVariable(label='Result Value')
        public Decimal resultValue;

        @InvocableVariable(label='Record Count')
        public Integer recordCount;

        @InvocableVariable(label='Success')
        public Boolean isSuccess;

        @InvocableVariable(label='Error Message')
        public String errorMessage;
    }

    @InvocableMethod(label='Rollup Calculator (Object/Field/Operation)' description='Runs a dynamic aggregate SOQL query based on runtime-selected Object, Field, and Operation')
    public static List<RollupResult> aggregate(List<RollupRequest> requests) {
        List<RollupResult> results = new List<RollupResult>();

        for (RollupRequest req : requests) {
            RollupResult res = new RollupResult();
            try {
                String op = req.operation.toUpperCase();
                Set<String> validOps = new Set<String>{'SUM','COUNT','MAX','MIN','AVG'};
                if (!validOps.contains(op)) {
                    throw new IllegalArgumentException('Invalid operation: ' + req.operation);
                }

                if (!Pattern.matches('^[a-zA-Z0-9_]+$', req.objectApiName) ||
                    !Pattern.matches('^[a-zA-Z0-9_]+$', req.fieldApiName)) {
                    throw new IllegalArgumentException('Invalid object or field API name.');
                }

                String soql;
                if (op == 'COUNT') {
                    soql = 'SELECT COUNT(Id) cnt FROM ' + req.objectApiName;
                } else {
                    soql = 'SELECT ' + op + '(' + req.fieldApiName + ') val, COUNT(Id) cnt FROM ' + req.objectApiName;
                }

                if (String.isNotBlank(req.filterCondition)) {
                    soql += ' WHERE ' + req.filterCondition;
                }

                List<AggregateResult> aggResults = Database.query(soql);

                if (!aggResults.isEmpty()) {
                    AggregateResult ar = aggResults[0];
                    res.recordCount = (Integer) ar.get('cnt');
                    res.resultValue = (op == 'COUNT') ? res.recordCount : (Decimal) ar.get('val');
                } else {
                    res.recordCount = 0;
                    res.resultValue = 0;
                }

                res.isSuccess = true;
            } catch (Exception e) {
                res.isSuccess = false;
                res.errorMessage = e.getMessage();
                res.resultValue = null;
            }

            results.add(res);
        }

        return results;
    }
}
